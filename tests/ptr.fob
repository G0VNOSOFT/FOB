; --- PRINTS из построенной строки ---
0x10 r0 #100
0x50 r0                ; "ABC"
0x10 r5 #0
0x50 r5                ; newline

; --- STORER / LOADR roundtrip ---
0x10 r0 #DEADBEEF
0x10 r1 #200
