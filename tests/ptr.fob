; --- STOREBR: построить "ABC\0" в mem[100] побайтово ---
0x10 r0 #41            ; 'A'
0x10 r1 #100
0x1D r1 r0             ; mem[100] = 'A'
0x2C r0 #1
0x2C r1 #1
