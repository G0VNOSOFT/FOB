0x1A r2 r1             ; r2 = mem[200]
0x52 r2                ; 3735928559
0x10 r5 #0
0x50 r5

; --- LOADBR байтов из "ABC" ---
0x10 r1 #100
0x1C r3 r1             ; r3 = mem[100] = 'A' = 65
0x52 r3
0x10 r5 #0
0x50 r5
