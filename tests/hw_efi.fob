0xF4CK 0xFF B1NǎRY
; === MSR: читаем IA32_APIC_BASE (0x1B) ===
0xA1 @100 "--- MSR (0x1B IA32_APIC_BASE) ---\r\n"
0x10 r0 #100
0x90 r0
0xA1 @200 "low32 = "
0x10 r0 #200
0x90 r0
0x10 r0 #1B
0x87
0x93 r0
0xA1 @300 "  high32 = "
0x10 r1 #300
0x90 r1
0x93 r1
0xA1 @400 "\r\n\r\n"

0x10 r2 #400
0x90 r2

; === POST port 0x80: просто пишем, читаем обратно и печатаем что пришло ===
0xA1 @500 "--- Port 0x80 (POST) ---\r\n"
0x10 r0 #500
0x90 r0
0xA1 @600 "write 0xAA, read back = 0x"
0x10 r0 #600
0x90 r0
0x10 r0 #AA
0x80 #80 r0
0x10 r0 #0
0x81 r0 #80
0x93 r0

0xA1 @700 "\r\n(0xAA = readback works, anything else = write-only port, normal)\r\n"

0x10 r0 #700
0x90 r0

; === PCI config mechanism #1: read VendorID of device 0:0:0 ===
0xA1 @800 "\r\n--- PCI 00:00.0 VendorID ---\r\n"
0x10 r0 #800
0x90 r0
0xA1 @900 "VendorID:DeviceID = 0x"
0x10 r0 #900
0x90 r0
; config address for bus=0 dev=0 fn=0 reg=0 = 0x80000000
0x10 r0 #80000000
0x8A #CF8 r0
0x10 r0 #0
0x8B r0 #CFC
0x93 r0
0xA1 @A00 "\r\n"

0x10 r0 #A00
0x90 r0

; === Прощаемся и держим экран ===
0xA1 @B00 "Press any key to return to firmware (then reboot).\r\n"
0x10 r0 #B00
0x90 r0
0x92
0xA1 @C00 "Bye.\r\n"
0x10 r0 #C00
0x90 r0
0x92
0x01
